    "wire": "node scripts/wire.mjs"
  },
  "dependencies": {
    "typescript": "6.0.3",
    "vscode-jsonrpc": "9.0.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "json-schema-to-typescript": "16.0.0"
  }
}
