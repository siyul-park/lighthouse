{
  "name": "lang-typescript",
  "version": "0.1.0",
  "private": true,
  "description": "Lighthouse language provider for TypeScript and JavaScript",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/wire.mjs && tsc -p tsconfig.json",
