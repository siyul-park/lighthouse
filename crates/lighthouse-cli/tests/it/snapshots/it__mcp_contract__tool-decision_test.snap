---
source: crates/lighthouse-cli/tests/it/mcp_contract.rs
expression: "serde_json::to_string_pretty(&tool).unwrap()"
---
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "Run the examples of checked decisions through the whole engine.\n\nThe bundled catalog and the project's `.lighthouse/decisions`. Examples run in each language whose plugin the config lists (or only in --language); a decision needs an example for every language run. Each example runs in a project of its own, so it does not depend on the project that runs it. One that cannot run here (a plugin that is not available, a command that is not installed or, in a project that is not trusted, not run) is reported as SKIP with the reason and counted in `skipped`; it is not a failure. Exits 1 when any example fails.",
  "inputSchema": {
    "additionalProperties": false,
    "description": "`decision test`.",
    "properties": {
      "decision": {
        "default": [],
        "description": "Decisions to test: ids and globs. Default: every checked decision.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "jobs": {
        "default": null,
        "description": "How many examples run at once. Default: as many as the machine runs at\nonce; 1 runs them in turn. What is reported does not depend on it.",
        "format": "uint",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "language": {
        "default": null,
        "description": "Run the examples in this language only.",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "type": "object"
  },
  "name": "decision_test",
  "outputSchema": {
    "$id": "https://raw.githubusercontent.com/siyul-park/lighthouse/main/schema/decision-test.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "The `DecisionTest` kind: the examples of the checked decisions, run.",
    "properties": {
      "conflicts": {
        "description": "One line per conflict with another decision that an example declares\nand still has: a candidate for a contradiction, not a failure.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "decisions": {
        "format": "uint",
        "minimum": 0,
        "type": "integer"
      },
      "failures": {
        "description": "One line per failing example; empty when every example holds.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "languages": {
        "format": "uint",
        "minimum": 0,
        "type": "integer"
      },
      "ok": {
        "description": "False when any example fails.",
        "type": "boolean"
      },
      "runs": {
        "format": "uint",
        "minimum": 0,
        "type": "integer"
      },
      "skipped": {
        "description": "One line per example that was not run because the program its command\ncheck names is not installed or not trusted, and one per plugin that\nexamples need and is not available, with how many examples that keeps\nfrom running; none of them is a failure.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "timings": {
        "description": "Where the time went; present only with `timings`.",
        "properties": {
          "check": {
            "description": "Building each example's engine and checking it.",
            "format": "double",
            "type": "number"
          },
          "crossing": {
            "description": "Checking the examples against the other decisions.",
            "format": "double",
            "type": "number"
          },
          "fix": {
            "description": "Applying the fixes and judging them.",
            "format": "double",
            "type": "number"
          },
          "pluginStart": {
            "description": "Starting the plugins.",
            "format": "double",
            "type": "number"
          },
          "slowest": {
            "description": "The decisions that took longest, with the language they ran in.",
            "items": {
              "description": "A decision and the time its examples took in one language.",
              "properties": {
                "decision": {
                  "type": "string"
                },
                "language": {
                  "type": "string"
                },
                "seconds": {
                  "format": "double",
                  "type": "number"
                }
              },
              "required": [
                "decision",
                "language",
                "seconds"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "pluginStart",
          "check",
          "fix",
          "crossing",
          "slowest"
        ],
        "type": [
          "object",
          "null"
        ]
      }
    },
    "required": [
      "ok",
      "decisions",
      "languages",
      "runs",
      "failures",
      "skipped",
      "conflicts"
    ],
    "title": "DecisionTest",
    "type": "object"
  },
  "title": "Run the examples of checked decisions through the whole engine"
}
