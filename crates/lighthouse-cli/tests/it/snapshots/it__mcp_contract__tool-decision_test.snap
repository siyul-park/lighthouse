source: crates/lighthouse-cli/tests/it/mcp_contract.rs
expression: "serde_json::to_string_pretty(&tool).unwrap()"
---
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "Run the examples of checked decisions through the whole engine.\n\nThe bundled catalog and the project's `.lighthouse/decisions`. Examples run in each language whose plugin the config lists (or only in --language); a decision needs an example for every language run. Exits 1 when any example fails.",
  "inputSchema": {
    "additionalProperties": false,
    "description": "`decision test`.",
    "properties": {
      "decision": {
        "default": [],
        "description": "Decisions to test: ids and globs. Default: every checked decision.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "language": {
        "default": null,
        "description": "Run the examples in this language only.",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "type": "object"
  },
  "name": "decision_test",
  "outputSchema": {
    "$id": "https://raw.githubusercontent.com/siyul-park/lighthouse/main/schema/decision-test.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "The `DecisionTest` kind: the examples of the checked decisions, run.",
    "properties": {
      "conflicts": {
        "description": "One line per conflict with another decision that an example declares\nand still has: a candidate for a contradiction, not a failure.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "decisions": {
        "format": "uint",
        "minimum": 0,
        "type": "integer"
      },
      "failures": {
        "description": "One line per failing example; empty when every example holds.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "languages": {
        "format": "uint",
        "minimum": 0,
        "type": "integer"
      },
      "ok": {
        "description": "False when any example fails.",
        "type": "boolean"
      },
      "runs": {
        "format": "uint",
        "minimum": 0,
        "type": "integer"
      },
      "skipped": {
        "description": "One line per example that was not run because the program its command\ncheck names is not installed; they are not failures.",
        "items": {
          "type": "string"
        },
        "type": "array"
      }
    },
    "required": [
      "ok",
      "decisions",
      "languages",
      "runs",
      "failures",
      "skipped",
      "conflicts"
    ],
    "title": "DecisionTest",
    "type": "object"
  },
  "title": "Run the examples of checked decisions through the whole engine"
}
