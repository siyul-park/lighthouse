  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "List the findings that ask for review.\n\nBy default the open findings of decisions that authored `warn` or `info` and that no judgment stands for. A finding's `last seen` is the `--seen` evidence `review resolve` takes.",
    "inputSchema": {
      "additionalProperties": false,
      "description": "`review list`.",
      "properties": {
        "all": {
          "default": false,
          "description": "Also list findings that do not ask for review (errors, and judged\nones).",
          "type": "boolean"
        },
        "decision": {
          "default": [],
          "description": "Only the findings of these decisions: ids or globs.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "detail": {
          "default": "compact",
          "description": "With `--format json`: compact groups findings by decision; full gives\none record per finding with its full fingerprint and `lastSeen`.",
          "oneOf": [
            {
              "const": "compact",
              "description": "Grouped by decision, a decision's text said once.",
              "type": "string"
            },
            {
              "const": "full",
              "description": "One self-contained record per item.",
              "type": "string"
            }
          ]
        },
        "limit": {
          "default": null,
          "description": "List at most this many findings, errors first, and say how many were\nleft out. Default: 50 with `--format json`, all otherwise.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "default": "open",
          "description": "Which findings: `open` is still reported and not suppressed.",
          "oneOf": [
            {
              "const": "open",
              "description": "Still reported and not suppressed.",
              "type": "string"
            },
            {
              "const": "suppressed",
              "description": "Kept out of reports by a judgment.",
              "type": "string"
            },
            {
              "const": "narrowing",
              "description": "Judged `notApplicable`, so the decision is too broad.",
              "type": "string"
            },
            {
              "const": "inactive",
              "description": "Of a rule the configuration no longer enables.",
              "type": "string"
            },
            {
              "const": "resolved",
              "description": "No longer reported by a complete run.",
              "type": "string"
            },
            {
              "const": "all",
              "description": "Every remembered finding.",
              "type": "string"
            }
          ]
        }
      },
      "type": "object"
    },
    "name": "review_list",
    "outputSchema": {
      "$id": "https://raw.githubusercontent.com/siyul-park/lighthouse/main/schema/review-list.schema.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "groups": {
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "judgments": {},
        "note": {
          "type": "string"
        },
        "notices": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "omitted": {
          "oneOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "properties": {
                "findings": {
                  "minimum": 0,
                  "type": "integer"
                },
                "groups": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "groups",
                "findings"
              ],
              "type": "object"
            }
          ]
        },
        "resolve": {
          "type": "string"
        },
        "tasks": {
          "items": {
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [],
      "title": "ReviewList",
      "type": "object"
    },
    "title": "List the findings that ask for review"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Record a judgment on a finding.\n\n`fail` means the finding is right; add --suppress with a justification to leave it in place on purpose (a SARIF `external` suppression). `pass` means the code conforms (a false positive); `notApplicable` means the decision does not apply here, a hint to narrow it. A judgment that is not `fail`, or a `fail` with a suppression, keeps the finding out of later reports while its decision and evidence stay as they are; an error is recorded but never hidden. Judgments are appended to .lighthouse/decisions.jsonl, which is meant to be committed, and never edited: a later one replaces the standing of the finding.\n\n--seen is the `last seen` time of the finding as you read it; the judgment is refused if the finding has been seen again since.\n\nExamples:\n  lighthouse review resolve 3fa9c1e --judgment pass --reason 'the helper is generated'\n  lighthouse review resolve 3fa9c1e --judgment fail --suppress 'tracked in #214'\n  lighthouse review resolve 3fa9c1e --judgment notApplicable --attributed-to agent:claude",
    "inputSchema": {
      "additionalProperties": false,
      "description": "`review resolve`.",
      "properties": {
        "attributedTo": {
          "default": null,
          "description": "Who the judgment is attributed to: `person` or `agent`, with an id\nafter a colon (`agent:claude`). Default: the person from `git config\nuser.name` on the command line, the client's name through MCP.",
          "type": [
            "string",
            "null"
          ]
        },
        "fingerprint": {
          "description": "A fingerprint, or the start of one (at least 7 characters).",
          "type": "string"
        },
        "judgment": {
          "description": "`fail`: the finding is right. `pass`: the code conforms. `notApplicable`:\nthe decision does not apply here.",
          "oneOf": [
            {
              "const": "pass",
              "description": "The code conforms: the finding is a false positive.",
              "type": "string"
            },
            {
              "const": "fail",
              "description": "The finding is right.",
              "type": "string"
            },
            {
              "const": "notApplicable",
              "description": "The decision does not apply here; a hint to narrow it.",
              "type": "string"
            }
          ]
        },
        "reason": {
          "default": null,
          "description": "Why, written for the next reader.",
          "type": [
            "string",
            "null"
          ]
        },
        "seen": {
          "default": null,
          "description": "The `last seen` time of the finding as you read it (its `seen`\nevidence); refuses the judgment if the finding has been seen again\nsince.",
          "type": [
            "string",
            "null"
          ]
        },
        "suppress": {
          "default": null,
          "description": "With `fail`: why the finding stays, recorded as an external\nsuppression that keeps it out of later reports.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "fingerprint",
        "judgment"
      ],
      "type": "object"
    },
    "name": "review_resolve",
    "outputSchema": {
      "$id": "https://raw.githubusercontent.com/siyul-park/lighthouse/main/schema/resolve-report.schema.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "catalogError": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "recorded": {
          "properties": {
            "decision": {
              "type": "string"
            },
            "fingerprint": {
              "type": "string"
            },
            "judgment": {
              "type": "string"
            },
            "suppression": {
              "anyOf": [
                {
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            },
            "wasAttributedTo": {}
          },
          "required": [
            "fingerprint",
            "decision",
            "judgment"
          ],
          "type": "object"
        },
        "standing": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "recorded",
        "warnings"
      ],
      "title": "ResolveReport",
      "type": "object"
    },
    "title": "Record a judgment on a finding"
  },
  {
