      "decided": {
        "description": "Labelled subjects the candidate decides that the current check leaves\nfor review.",
        "format": "uint",
        "minimum": 0,
        "type": "integer"
      },
      "decision": {
        "type": "string"
      },
      "labelled": {
        "format": "uint",
        "minimum": 0,
        "type": "integer"
      },
      "meetsPolicy": {
        "description": "Whether the check (the candidate, when there is one) meets the\nevaluation policy by the point estimates of its precision and, when the\npolicy sets a target, of its recall; the intervals are shown beside.",
        "type": [
          "boolean",
          "null"
        ]
      },
      "policy": {
        "additionalProperties": false,
        "description": "How a rule's check is judged by `lighthouse eval`. A policy, not a\nmeaning: changing it moves no meaning version.",
        "properties": {
          "precision": {
            "default": 0.9,
            "description": "The precision a check must reach, from 0 to 1. Default: 0.9.",
            "format": "double",
            "type": "number"
          },
          "recall": {
            "description": "The recall a check must reach, from 0 to 1; no target when absent.",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "precision"
        ],
        "type": "object"
      },
      "proposal": {
        "description": "What to do about an attached model that misses the policy: detach it.",
        "properties": {
          "model": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "model",
          "reason"
