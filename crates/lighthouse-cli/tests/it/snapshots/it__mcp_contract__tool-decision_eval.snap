---
source: crates/lighthouse-cli/tests/it/mcp_contract.rs
expression: "serde_json::to_string_pretty(&tool).unwrap()"
---
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "Measure a decision's check against its labels.\n\nReports precision, FPR, recall, FNR, selector precision and coverage, each with a Wilson 95% interval; the Brier score, ECE and AUROC of the probabilities models gave, with how many subjects they answered; the model calls and their cost, and a verdict against the decision's evaluation policy (`rules.\"<id>\".evaluation`). With --check, a candidate decision file is measured beside it and their agreement is reported. Labelled positives come mostly from flagged findings, so recall is an upper bound; --audit writes unflagged selected subjects for a person to label.\n\nExamples:\n  lighthouse decision eval design/prefer-method\n  lighthouse decision eval design/prefer-method --check candidate.yaml --format json\n  lighthouse decision eval design/prefer-method --repo cel=../cel --audit 50",
  "inputSchema": {
    "additionalProperties": false,
    "description": "`decision eval`.",
    "properties": {
      "audit": {
        "description": "Write this many selected subjects the check did not flag to a table\nfor a person to label (`TP` or `FP`), to measure recall.",
        "format": "uint",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "check": {
        "description": "A decision file whose check is evaluated beside the current one.",
        "type": [
          "string",
          "null"
        ]
      },
      "id": {
        "description": "The decision, such as `design/prefer-method`.",
        "type": "string"
      },
      "labels": {
        "default": null,
        "description": "A table of reviewed findings (`fingerprint repo location verdict`).\nDefault: `plugins/<pack>/labels/<name>.tsv` for the decision `<pack>/<name>`, when it exists.",
        "type": [
          "string",
          "null"
        ]
      },
      "model": {
        "description": "A model to grade as the first layer of the decision, beside the\ncurrent check: `<provider>/<model>@sha256:<hex>`. One fitted on labels\nis graded on those by refits that leave each fold out.",
        "type": [
          "string",
          "null"
        ]
      },
      "repo": {
        "default": [],
        "description": "A repository the labels are about, `name=dir`, where `name` is the\n`repo` column of the table. Repeatable; default: this project.",
        "items": {
          "type": "string"
        },
        "type": "array"
      }
    },
    "required": [
      "id"
    ],
    "type": "object"
  },
  "name": "decision_eval",
  "outputSchema": {
    "$id": "https://raw.githubusercontent.com/siyul-park/lighthouse/main/schema/decision-eval.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "The result of an evaluation.",
    "properties": {
      "agreement": {
        "description": "How often the candidate answers as the current check does.",
        "properties": {
          "high": {
            "format": "double",
            "type": "number"
          },
          "hits": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "low": {
            "format": "double",
            "type": "number"
          },
          "of": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "value": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "hits",
          "of",
          "value",
          "low",
          "high"
        ],
        "type": [
          "object",
          "null"
        ]
      },
      "audit": {
        "description": "The table of unflagged subjects written for a person to label.",
        "type": [
          "string",
          "null"
        ]
      },
      "candidate": {
        "description": "One check's numbers.",
        "properties": {
          "calls": {
            "description": "Questions put to models, and what they cost.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "check": {
            "type": "string"
          },
          "cost": {
            "format": "double",
            "type": "number"
          },
          "layer": {
            "description": "The model attached by revision this side is graded with, and how.",
            "properties": {
              "crossFitted": {
                "description": "Labelled subjects the model learned from, graded by refits.",
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "model": {
                "type": "string"
              },
              "refits": {
                "description": "The models the refits made.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "trainingFile": {
                "description": "The dataset (`sha256:<hex>`) the model learned from, when its artifact\nis in the store.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "model",
              "crossFitted",
              "refits"
            ],
            "type": [
              "object",
              "null"
            ]
          },
          "metrics": {
            "description": "The metrics, each `None` where there is nothing to divide.",
            "properties": {
              "answered": {
                "description": "Labelled subjects a model gave a probability of failing; the rest\nabstained and are counted, not scored.",
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "auroc": {
                "description": "The probability that a `fail` is given a higher P(fail) than a `pass`,\nties counting half (scikit-learn's `roc_auc_score`); `None` when one\nclass is missing.",
                "format": "double",
                "type": [
                  "number",
                  "null"
                ]
              },
              "brier": {
                "description": "Mean (P(fail) - y)^2 over the answered subjects, y = 1 for a `fail`\n(scikit-learn's `brier_score_loss`).",
                "format": "double",
                "type": [
                  "number",
                  "null"
                ]
              },
              "coverage": {
                "description": "The share of selected subjects the check decided; its complement is the\nshare left to review.",
                "properties": {
                  "high": {
                    "format": "double",
                    "type": "number"
                  },
                  "hits": {
                    "format": "uint",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "low": {
                    "format": "double",
                    "type": "number"
                  },
                  "of": {
                    "format": "uint",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "value": {
                    "format": "double",
                    "type": "number"
                  }
                },
                "required": [
                  "hits",
                  "of",
                  "value",
                  "low",
                  "high"
                ],
                "type": [
                  "object",
                  "null"
                ]
              },
              "ece": {
                "description": "Expected calibration error over the answered subjects: the bins of P(fail)\nweigh the gap between the share of fails and the mean P(fail)\n(Guo et al., ICML 2017).",
                "format": "double",
                "type": [
                  "number",
                  "null"
                ]
              },
              "fnr": {
                "description": "A proportion with its Wilson 95% interval.",
