---
source: crates/lighthouse-cli/tests/it/mcp_contract.rs
expression: "serde_json::to_string_pretty(&tool).unwrap()"
---
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Check the project and print findings.\n\nPATHS select which findings are reported, not what is analyzed: the whole project is always analyzed, because decisions and language providers need more than the reported files (callers, packages, build context).\n\nExit codes: 0 clean, 1 an error was found (or warnings fail the run: --strict, --max-warnings; info never does), 2 usage or runtime error, 3 the analysis was incomplete (a file could not be read or loaded, a plugin crashed or timed out). \"Not checked\" is never \"passed\"; --allow-incomplete reports it but does not fail on it.\n\nPlugins named by the config are started and run with your privileges, like build scripts: only check projects whose config you trust. A plugin that cannot start, or that is not the protocol version or identity its entry names, is an error (exit 2); one that starts but crashes, times out or answers badly is reported as incomplete (exit 3).\n\nExamples:\n  lighthouse check\n  lighthouse check src/ --decision 'design/*' --format json --limit 10\n  lighthouse check --changed --strict\n  lighthouse check --fix --dry-run --decision design/exported-doc",
  "inputSchema": {
    "additionalProperties": false,
    "description": "`check`: analyze the project and report. Analysis is always whole-project;\nthe arguments narrow what is reported and how.",
    "properties": {
      "allModels": {
        "default": false,
        "description": "Ask models that cost about the whole project, not only the files the\nrun reports.",
        "type": "boolean"
      },
      "allowIncomplete": {
        "default": false,
        "description": "Exit by findings even when the analysis was incomplete; the\nincompleteness is still reported.",
        "type": "boolean"
      },
      "changed": {
        "default": false,
        "description": "Report only files changed in the working tree against HEAD (modified,\nadded, renamed, untracked). A report filter like PATHS.",
        "type": "boolean"
      },
      "decision": {
        "default": [],
        "description": "Run only these decisions: ids, comma-separated or repeated, and globs\nsuch as `design/*`.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "detail": {
        "default": "compact",
        "description": "With `--format json`: compact groups findings by decision and states a\ndecision's text once; full gives one self-contained record per finding.",
        "oneOf": [
          {
            "const": "compact",
            "description": "Grouped by decision, a decision's text said once.",
            "type": "string"
          },
          {
            "const": "full",
            "description": "One self-contained record per item.",
            "type": "string"
          }
        ]
      },
      "diff": {
        "default": null,
        "description": "Report only files changed since the merge base of BASE and HEAD,\nincluding the working tree and untracked files. A report filter.",
        "type": [
          "string",
          "null"
        ]
      },
      "limit": {
        "default": null,
        "description": "Report at most this many findings, errors first, and say how many were\nleft out. Default: 25 with `--format json`, all otherwise.",
        "format": "uint",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "maxWarnings": {
        "default": null,
        "description": "Fail when there are more than N warnings (errors always fail).",
        "format": "uint",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "noCache": {
        "default": false,
        "description": "Run every rule instead of reusing the findings of earlier runs kept in\n`.lighthouse/cache`. The findings and the exit code are the same.",
        "type": "boolean"
      },
      "noModels": {
        "default": false,
        "description": "Ask no model: what they would judge is left to review.",
        "type": "boolean"
      },
      "noStore": {
        "default": false,
        "description": "Do not record this run in `.lighthouse/lighthouse.db` and do not apply\njudgments. By default a run is recorded: findings it no longer reports\nare marked resolved (never when the analysis was incomplete), and\nfindings whose latest judgment hides them stay out of the report.",
        "type": "boolean"
      },
      "paths": {
        "default": [],
        "description": "Where to report findings; the whole project is analyzed anyway.\nDefault: the whole project.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "recordModelLabels": {
        "default": false,
        "description": "Record what models fail as judgments attributed to them, so that\ntraining can reproduce them from `decisions.jsonl`.",
        "type": "boolean"
      },
      "strict": {
        "default": false,
        "description": "Fail on warnings too.",
        "type": "boolean"
      }
    },
    "type": "object"
  },
  "name": "check",
  "outputSchema": {
    "$id": "https://raw.githubusercontent.com/siyul-park/lighthouse/main/schema/check-report.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "description": "The findings grouped by decision.",
        "properties": {
          "counts": {
            "description": "The counts of a compact report: findings by severity (a subject left to\nreview is no finding) and those that ask for review, always; the rest when\nthey are not zero.",
            "properties": {
              "allowed": {
                "description": "Findings source directives suppress.",
                "format": "uint",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "error": {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "info": {
                "format": "uint",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "review": {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "suppressed": {
                "description": "Findings judgments kept out of the report.",
                "format": "uint",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "warn": {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "error",
              "warn",
              "review"
            ],
            "type": "object"
          },
          "groups": {
            "items": true,
            "type": "array"
          },
          "incomplete": {
            "description": "What was not checked: `[path, reason]` pairs.",
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                {
                  "type": "string"
                }
              ],
              "type": "array"
            },
            "type": "array"
          },
          "judgments": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "What each judgment says; present with `resolve`.",
            "type": [
              "object",
              "null"
            ]
          },
          "messages": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "omitted": {
            "description": "What the limit left out.",
            "properties": {
              "findings": {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "groups": {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "groups",
              "findings"
            ],
            "type": [
              "object",
              "null"
            ]
          },
          "resolve": {
            "description": "How a judgment is recorded, said once for all groups; present when a\nshown finding asks for review.",
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "description": "How a compact report stands.",
            "oneOf": [
              {
                "enum": [
                  "clean"
                ],
                "type": "string"
              },
              {
                "const": "findings",
                "description": "Some finding is a decision's verdict.",
                "type": "string"
              },
              {
                "const": "review",
                "description": "Every finding is a subject nothing decided, left to review.",
                "type": "string"
              },
              {
                "const": "incomplete",
                "description": "Part of the project was not checked.",
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "status",
          "counts",
          "groups"
        ],
        "type": "object"
      },
      {
        "description": "One self-contained record per finding.",
        "properties": {
          "findings": {
            "items": true,
            "type": "array"
          },
          "incomplete": {
            "items": {
              "description": "A part of the project that was not checked, and why.",
              "properties": {
                "path": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "reason": {
                  "type": "string"
                },
                "type": {
                  "description": "`incomplete`.",
                  "type": "string"
                }
              },
              "required": [
                "type",
                "path",
                "reason"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "judgments": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "What each judgment says; present when a shown finding asks for review.",
            "type": [
              "object",
              "null"
            ]
          },
          "messages": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "omitted": {
            "description": "Findings the limit left out.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "status": {
            "description": "How a run ended. `Incomplete` wins over everything: \"not checked\" is never\n\"passed\".",
            "enum": [
              "clean",
              "findings",
              "incomplete"
            ],
            "type": "string"
          },
          "summary": {
            "description": "The counts of a run, shared by every frontend that reports on one.",
            "properties": {
              "allowed": {
                "description": "Findings that directives in the code suppress.",
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "errors": {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "incomplete": {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "infos": {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "reviews": {
                "description": "Findings of decisions that authored `warn` or `info` and that no\njudgment stands for: the ones that ask for review.",
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "status": {
                "description": "How a run ended. `Incomplete` wins over everything: \"not checked\" is never\n\"passed\".",
                "enum": [
                  "clean",
                  "findings",
                  "incomplete"
                ],
                "type": "string"
              },
              "suppressed": {
                "description": "Findings that judgments kept out of the report.",
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "warnings": {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "status",
              "errors",
              "warnings",
              "infos",
              "reviews",
              "incomplete",
              "suppressed",
              "allowed"
            ],
            "type": "object"
          }
        },
        "required": [
          "findings",
          "incomplete",
          "omitted",
          "status",
          "summary",
          "messages"
        ],
        "type": "object"
      }
    ],
    "description": "The `CheckReport` kind: the findings of a run for a program, with the gaps,\nthe counts and what the run has to say.",
    "title": "CheckReport",
    "type": "object"
  },
  "title": "Check the project and print findings"
}
