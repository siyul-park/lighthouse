---
source: crates/lighthouse-cli/tests/it/mcp_contract.rs
expression: "serde_json::to_string_pretty(&tool).unwrap()"
---
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Add a project-local decision from a Decision document.\n\nThe document is YAML or JSON, from a file or stdin (`-`). Nothing is written unless the candidate validates, compiles and every example passes the whole engine; a rejection leaves the project untouched. A document without `spec.status` is written as `proposed`: it produces no findings until a person accepts it. Decisions that may repeat it are named in the reply (\"possible duplicate\"), and the signals named in `provenance.wasDerivedFrom` as `signal:<id>` become recorded. The decision also needs the `local` plugin in lighthouse.toml to run in `check`.",
  "inputSchema": {
    "additionalProperties": false,
    "description": "`decision create` and `decision update`.",
    "properties": {
      "document": {
        "description": "A `Decision` document, as YAML or JSON. On the command line this is a\nfile, or `-` for stdin; the tool takes the text or the object.\n`metadata.name` is the id (`local/<name>`); `spec.examples` needs at\nleast one valid and one invalid example per language the project runs.",
        "type": [
          "string",
          "object"
        ]
      }
    },
    "required": [
      "document"
    ],
    "type": "object"
  },
  "name": "decision_create",
  "outputSchema": {
    "$id": "https://raw.githubusercontent.com/siyul-park/lighthouse/main/schema/decision-report.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "A decision change that passed its gate and was written: the\n`DecisionReport` kind.",
    "properties": {
      "created": {
        "type": "boolean"
      },
      "duplicates": {
        "description": "Existing decisions the new one may repeat; the decision is written\nanyway, because a person decides.",
        "items": {
          "description": "An existing decision a new one may repeat.",
          "properties": {
            "id": {
              "type": "string"
            },
            "requirement": {
              "description": "The first line of its requirement.",
              "type": "string"
            },
            "similarity": {
              "description": "BM25 of the decision for the new text, from 0 to 1.",
              "format": "double",
              "type": "number"
            },
            "status": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "status",
            "requirement",
            "similarity"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "id": {
        "type": "string"
      },
      "note": {
        "description": "What to do next.",
        "type": "string"
      },
      "path": {
        "type": "string"
      },
      "signals": {
        "description": "The signals now recorded or linked, by id.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "tested": {
        "description": "What the gate ran before the decision was written.",
        "properties": {
          "conflicts": {
            "description": "One line per conflict with another decision that an example declares\nand still has: a candidate for a contradiction, not a failure.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "decisions": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "failures": {
            "description": "One line per failing example; empty when every example holds.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "languages": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "runs": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "skipped": {
            "description": "One line per example that was not run because the program its command\ncheck names is not installed; they are not failures.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "decisions",
          "languages",
          "runs",
          "failures",
          "skipped",
          "conflicts"
        ],
        "type": "object"
      },
      "unknownSignals": {
        "description": "Signals the document names that the store does not hold.",
        "items": {
          "type": "string"
        },
        "type": "array"
      }
    },
    "required": [
      "id",
      "path",
      "created",
      "tested",
      "note"
    ],
    "title": "DecisionReport",
    "type": "object"
  },
  "title": "Add a project-local decision from a Decision document"
}
