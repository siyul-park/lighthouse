---
source: crates/lighthouse-cli/tests/it/mcp_contract.rs
expression: "serde_json::to_string_pretty(&tool).unwrap()"
---
{
  "annotations": {
    "destructiveHint": true,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Fix findings with the fixers the decisions name (`fix` in `decision_list`: who makes it, `safe` or `unsafe`, whether it runs). Select what to fix with `fingerprints` (findings from `check`, prefixes of at least 7 characters allowed), `paths` or `decision`; at least one is required. A fix is proposed, applied, re-checked (the safe fixes of what it introduced follow it) and rolled back for any file that gains an error or stops being analyzed, and repeated until nothing is left (at most 5 rounds). Only `safe` fixes are written, whatever makes them; an `unsafe` one is returned as a preview with its diff and the call that applies exactly it (`fingerprints` of every finding of its run, with `unsafeFixes`), unless `unsafeFixes` is true or, when it is not set, the project's `[fix] unsafe` is true; `unsafeFixes: false` only previews. Applying a preview writes exactly the edit that was shown, kept by the run that made it: a file that changed since gives a conflict and writes nothing, and a preview that is not kept is declined. `noModels` asks no model. Use `dryRun` first to see the unified `diff` without changing a file. Returns the `diff`, the `applied` fixes, the `previews` and the `declined` findings with the reason each was left alone; recheck with `check` afterwards. Findings a judgment hides are never fixed.",
  "inputSchema": {
    "additionalProperties": false,
    "description": "`fix`, the tool of `check --fix`: which findings, and how to fix them.\nName at least one of `paths`, `decision` and `fingerprints`: a fix through\nMCP never defaults to the whole project.",
    "properties": {
      "decision": {
        "default": [],
        "description": "Fix the findings of these decisions: ids or globs.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "dryRun": {
        "default": false,
        "description": "Print the unified diff and leave every file as it was.",
        "type": "boolean"
      },
      "fingerprints": {
        "default": [],
        "description": "Fix these findings: fingerprints or unique prefixes of at least 7\ncharacters.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "fixer": {
        "default": null,
        "description": "Use this registered fixer for the selected findings instead of the one\ntheir decision names. Its fixes are `unsafe`.",
        "type": [
          "string",
          "null"
        ]
      },
      "noModels": {
        "default": false,
        "description": "Ask no model: what they would fix is left to review.",
        "type": "boolean"
      },
      "paths": {
        "default": [],
        "description": "Fix findings under these paths.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "unsafeFixes": {
        "default": null,
        "description": "Write `unsafe` fixes, which are judgment calls, whatever makes them\n(`true`), or only preview them (`false`); unset, `[fix] unsafe`\ndecides. A preview is applied by naming its finding.",
        "type": [
          "boolean",
          "null"
        ]
      }
    },
    "type": "object"
  },
  "name": "fix",
  "outputSchema": {
    "$id": "https://raw.githubusercontent.com/siyul-park/lighthouse/main/schema/fix-report.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "A finished fix run: the `FixReport` kind.",
    "properties": {
      "applied": {
        "items": {
          "description": "A fix that was applied.",
          "properties": {
            "decision": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "files": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "fingerprint": {
              "type": "string"
            },
            "fixer": {
              "type": "string"
            },
            "follow_up": {
              "description": "A safe fix of what the change of other fixes introduced, in a file they\nall edited: the part of the change that is not theirs. In a file one fix\nedited it is part of that fix.",
              "type": "boolean"
            },
            "safety": {
              "type": "string"
            }
          },
          "required": [
            "fingerprint",
            "decision",
            "fixer",
            "safety",
            "description",
            "files"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "declined": {
        "items": {
          "description": "A finding that was left as it was, and why.",
          "properties": {
            "decision": {
              "type": "string"
            },
            "fingerprint": {
              "type": "string"
            },
            "line": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "path": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "fingerprint",
            "decision",
            "path",
            "line",
            "reason"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "diff": {
        "description": "The unified diff of every changed file, in path order.",
        "type": "string"
      },
      "dryRun": {
        "type": "boolean"
      },
      "messages": {
        "description": "What the user should know, in the order it happened.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "models": {
        "additionalProperties": {
          "description": "What became of the findings of one decision that were given to a model.",
          "properties": {
            "answered": {
              "description": "Of them, those it replied to.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "applied": {
              "description": "Verified fixes that were written.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "asked": {
              "description": "Findings the model was asked about.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "declined": {
              "additionalProperties": {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "description": "Findings left as they were, by the class of the reason: `no-extent`,\n`unanswered`, `out-of-scope`, `conflict`, `unchanged`, `unresolved`,\n`introduced`, `incomplete` or `rolled-back`.",
              "type": "object"
            },
            "previewed": {
              "description": "Verified fixes left as previews.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "verified": {
              "description": "Replies the checks accepted.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "asked",
            "answered",
            "verified",
            "applied",
            "previewed",
            "declined"
          ],
          "type": "object"
        },
        "description": "What became of the findings given to a model, by decision. Absent when\nno model was asked.",
        "type": "object"
      },
      "previews": {
        "description": "`unsafe` fixes, by any provider, that the checks accepted and that were\nleft for a hand to apply (`[fix] unsafe = false` without\n`--unsafe-fixes`, or a failing `[fix] verify` command), each with its\ndiff and how to apply it. Absent when there are none.",
        "items": {
          "description": "An `unsafe` fix that was left for a hand to apply.",
          "properties": {
            "apply": {
              "description": "The command line.",
              "type": "string"
            },
            "decision": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "diff": {
              "description": "The unified diff of the fix.",
              "type": "string"
            },
            "files": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "fingerprint": {
              "type": "string"
            },
            "fixer": {
              "type": "string"
            },
            "safety": {
              "type": "string"
            },
            "tool": {
              "description": "A tool call: the twin of a command line.",
              "properties": {
                "arguments": true,
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "arguments"
              ],
              "type": "object"
            }
          },
          "required": [
            "fingerprint",
            "decision",
            "fixer",
            "safety",
            "description",
            "files",
            "diff",
            "apply",
            "tool"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "rounds": {
        "description": "How many times fixing was repeated until nothing was left.",
        "format": "uint",
        "minimum": 0,
        "type": "integer"
      },
      "usage": {
        "description": "The requests that went to a model this run, and what they cost.\nAbsent when no model was asked.",
        "properties": {
          "agent": {
            "description": "Present when the model is an agent.",
            "properties": {
              "batches": {
                "description": "What each run did, from the events its harness reported; absent when\nthe provider declares none. A run that was kept from an earlier one has\nno entry.",
                "items": {
                  "description": "What an agent did for the findings of one file. A measurement: it never\ndecides a fix.",
                  "properties": {
                    "calls": {
                      "description": "How many calls of each tool it made.",
                      "properties": {
                        "edit": {
                          "format": "uint",
                          "minimum": 0,
                          "type": "integer"
                        },
                        "list": {
                          "format": "uint",
                          "minimum": 0,
                          "type": "integer"
                        },
                        "read": {
                          "format": "uint",
                          "minimum": 0,
                          "type": "integer"
                        },
                        "run": {
                          "format": "uint",
                          "minimum": 0,
                          "type": "integer"
                        },
                        "search": {
                          "format": "uint",
                          "minimum": 0,
                          "type": "integer"
                        }
                      },
                      "required": [
                        "read",
                        "search",
                        "list",
                        "edit",
                        "run"
                      ],
                      "type": "object"
                    },
                    "file": {
                      "description": "The file the findings are in.",
                      "type": "string"
                    },
                    "incomplete": {
                      "description": "This is not all the agent did: `note` says what is missing.",
                      "type": "boolean"
                    },
                    "note": {
                      "description": "What is missing from this, when `incomplete`: output that was cut,\nevents past the count kept, events that were not understood.",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "reads": {
                      "description": "Files it read that the brief did not include, in the order it opened\nthem, each once; every file outside the project is one entry,\n`(outside the project)`.",
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "searches": {
                      "description": "What it searched, and the listings it made, in order.",
                      "items": {
                        "description": "One thing an agent did, as its harness reported it.",
                        "properties": {
                          "command": {
                            "description": "The command line of a `run`.",
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "outside": {
                            "description": "It was about a path outside the directory the agent ran in. The host\nsets this and drops the path, so that no path of the machine reaches a\nreport; a plugin leaves it out.",
                            "type": "boolean"
                          },
                          "path": {
                            "description": "The file or directory it was about, relative to the directory the\nagent ran in, as the host normalizes it. A plugin may send it absolute\nor relative to that directory.",
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "pattern": {
                            "description": "What a `search` looked for, or the glob of a `list`.",
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "tool": {
                            "description": "What an agent did with a tool: the kinds of its work that a fix report\ntells apart.",
                            "oneOf": [
                              {
                                "const": "read",
                                "description": "Opened a file.",
                                "type": "string"
                              },
                              {
                                "const": "search",
                                "description": "Searched file contents for a pattern.",
                                "type": "string"
                              },
                              {
                                "const": "list",
                                "description": "Listed files or a directory.",
                                "type": "string"
                              },
                              {
                                "const": "edit",
                                "description": "Wrote or changed a file.",
                                "type": "string"
                              },
                              {
                                "const": "run",
                                "description": "Ran a command.",
                                "type": "string"
                              }
                            ]
                          }
                        },
                        "required": [
                          "tool"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "file",
                    "reads",
                    "searches",
                    "calls"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "runs": {
                "description": "Runs of the agent; answers kept from earlier runs are not counted.",
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "seconds": {
                "format": "double",
                "type": "number"
              }
            },
            "required": [
              "runs",
              "seconds"
            ],
            "type": [
              "object",
              "null"
            ]
          },
          "calls": {
            "description": "Requests that went to a model; answers kept from earlier runs are not\ncounted.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "cost": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "calls",
          "cost"
        ],
        "type": [
          "object",
          "null"
        ]
      }
    },
    "required": [
      "dryRun",
      "diff",
      "applied",
      "declined",
      "rounds",
      "messages"
    ],
    "title": "FixReport",
    "type": "object"
  },
  "title": "Fix findings with the fixers their decisions name."
}
