---
source: crates/lighthouse-cli/tests/it/mcp_contract.rs
expression: "serde_json::to_string_pretty(&tool).unwrap()"
---
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "List the decisions that have a rule",
  "inputSchema": {
    "additionalProperties": false,
    "description": "`decision list`.",
    "properties": {
      "all": {
        "default": false,
        "description": "Include every catalog decision with its implementation status.",
        "type": "boolean"
      },
      "limit": {
        "default": null,
        "description": "List at most this many decisions and say how many were left out.",
        "format": "uint",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      }
    },
    "type": "object"
  },
  "name": "decision_list",
  "outputSchema": {
    "$id": "https://raw.githubusercontent.com/siyul-park/lighthouse/main/schema/decision-list.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "The `DecisionList` kind: the decisions with a rule, or every one.",
    "properties": {
      "decisions": {
        "items": {
          "description": "One decision of a listing.",
          "properties": {
            "enabled": {
              "description": "Whether this project's configuration enables it.",
              "type": "boolean"
            },
            "id": {
              "type": "string"
            },
            "severity": {
              "type": "string"
            },
            "status": {
              "description": "How far a decision is carried out.",
              "oneOf": [
                {
                  "const": "not-enforced",
                  "description": "Its status is not accepted: written down, tested, not enforced.",
                  "type": "string"
                },
                {
                  "const": "implemented",
                  "description": "A program checks it.",
                  "type": "string"
                },
                {
                  "const": "judged",
                  "description": "Agent review checks it.",
                  "type": "string"
                },
                {
                  "const": "unimplemented",
                  "description": "A check is named but nothing registers it.",
                  "type": "string"
                },
                {
                  "const": "doc",
                  "description": "It has no check.",
                  "type": "string"
                }
              ]
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "status",
            "severity",
            "title",
            "enabled"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "omitted": {
        "description": "How many decisions `limit` left out.",
        "format": "uint",
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "decisions",
      "omitted"
    ],
    "title": "DecisionList",
    "type": "object"
  },
  "title": "List the decisions that have a rule"
}
