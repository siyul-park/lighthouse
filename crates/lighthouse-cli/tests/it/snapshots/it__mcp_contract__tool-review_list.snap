---
source: crates/lighthouse-cli/tests/it/mcp_contract.rs
expression: "serde_json::to_string_pretty(&tool).unwrap()"
---
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "List the findings that ask for review.\n\nBy default the open findings of decisions that authored `warn` or `info` and that no judgment stands for. A finding's `last seen` is the `--seen` evidence `review resolve` takes.",
  "inputSchema": {
    "additionalProperties": false,
    "description": "`review list`.",
    "properties": {
      "all": {
        "default": false,
        "description": "Also list findings that do not ask for review (errors, and judged\nones).",
        "type": "boolean"
      },
      "decision": {
        "default": [],
        "description": "Only the findings of these decisions: ids or globs.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "detail": {
        "default": "compact",
        "description": "With `--format json`: compact groups findings by decision; full gives\none record per finding with its full fingerprint and `lastSeen`.",
        "oneOf": [
          {
            "const": "compact",
            "description": "Grouped by decision, a decision's text said once.",
            "type": "string"
          },
          {
            "const": "full",
            "description": "One self-contained record per item.",
            "type": "string"
          }
        ]
      },
      "limit": {
        "default": null,
        "description": "List at most this many findings, errors first, and say how many were\nleft out. Default: 50 with `--format json`, all otherwise.",
        "format": "uint",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "status": {
        "default": "open",
        "description": "Which findings: `open` is still reported and not suppressed.",
        "oneOf": [
          {
            "const": "open",
            "description": "Still reported and not suppressed.",
            "type": "string"
          },
          {
            "const": "suppressed",
            "description": "Kept out of reports by a judgment.",
            "type": "string"
          },
          {
            "const": "narrowing",
            "description": "Judged `notApplicable`, so the decision is too broad.",
            "type": "string"
          },
          {
            "const": "inactive",
            "description": "Of a rule the configuration no longer enables.",
            "type": "string"
          },
          {
            "const": "resolved",
            "description": "No longer reported by a complete run.",
            "type": "string"
          },
          {
            "const": "all",
            "description": "Every remembered finding.",
            "type": "string"
          }
        ]
      }
    },
    "type": "object"
  },
  "name": "review_list",
  "outputSchema": {
    "$id": "https://raw.githubusercontent.com/siyul-park/lighthouse/main/schema/review-list.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "description": "Grouped by decision.",
        "properties": {
          "groups": {
            "items": true,
            "type": "array"
          },
          "judgments": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "What each judgment says; present with `resolve`.",
            "type": [
              "object",
              "null"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "notices": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "omitted": {
            "description": "What the limit left out.",
            "properties": {
              "findings": {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "groups": {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "groups",
              "findings"
            ],
            "type": [
              "object",
              "null"
            ]
          },
          "resolve": {
            "description": "How a judgment is recorded, said once for all groups; present when a\nshown finding asks for review.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "groups"
        ],
        "type": "object"
      },
      {
        "description": "One record per finding.",
        "properties": {
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "notices": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "omitted": {
            "description": "How many findings `limit` left out.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "tasks": {
            "items": {
              "description": "A finding as stored: its latest sighting, its history and its standing.",
              "properties": {
                "authoredSeverity": {
                  "description": "The severity its decision authored: what decides whether a judgment may\nhide the finding. For a rule without a decision, the severity it\nreported.",
                  "oneOf": [
                    {
                      "const": "error",
                      "description": "Fails the run.",
                      "type": "string"
                    },
                    {
                      "const": "warn",
                      "description": "Fails the run only under `--strict` or past `--max-warnings`.",
                      "type": "string"
                    },
                    {
                      "const": "info",
                      "description": "Reported, never fails the run.",
                      "type": "string"
                    }
                  ]
                },
                "catalogVersion": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "commit": {
                  "description": "Commit and cleanliness of the working tree at the last sighting.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "decision": {
                  "type": "string"
                },
                "decisionUid": {
                  "description": "The uid of the finding's decision, when the catalog gave it one.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "dirty": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "evidence": true,
                "facts": {
                  "description": "What the analysis knew about the subject: language, symbol shape,\nmeasures. Frozen into a judgment's feature snapshot."
                },
                "fingerprint": {
                  "type": "string"
                },
                "firstSeen": {
                  "type": "string"
                },
                "inactiveAt": {
                  "description": "Set when the configuration no longer enables the finding's rule.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "judgment": {
                  "anyOf": [
                    {
                      "description": "A recorded label on one subject, as SARIF's `result.kind` says it: not\nground truth. `pass` and `fail` label the check's conformance part;\n`notApplicable` labels its applicability part (the decision should not\napply here).",
                      "oneOf": [
                        {
                          "const": "pass",
                          "description": "The subject conforms: a finding about it was a false positive.",
                          "type": "string"
                        },
                        {
                          "const": "fail",
                          "description": "The subject violates the decision: a finding about it is right.",
                          "type": "string"
                        },
                        {
                          "const": "notApplicable",
                          "description": "The decision does not apply to the subject.",
                          "type": "string"
                        }
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The latest judgment, if the finding was judged."
                },
                "justification": {
                  "description": "The justification of the suppression that goes with the judgment.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "lastSeen": {
                  "type": "string"
                },
                "lighthouseVersion": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "locator": {
                  "description": "Where in the artifact: `{\"span\": {\"start\": {\"line\", \"col\"}, \"end\": ...}}`\nfor text."
                },
                "meaningVersion": {
                  "description": "Hash of what the rule's decision means; judgments expire when it moves.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "message": {
                  "type": "string"
                },
                "modelVersion": {
                  "description": "The model that decided the finding and the version of its program\n(`provider/model@hash`). Recorded, never compared to expire a judgment.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "narrowing": {
                  "description": "The judgment said the decision does not apply here.",
                  "type": "boolean"
                },
                "options": {
                  "description": "The options the rule ran with, defaults included."
                },
                "path": {
                  "description": "The artifact, project-relative with `/` separators.",
                  "type": "string"
                },
                "reopened": {
                  "description": "How many times it came back after being resolved.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "resolvedAt": {
                  "description": "Set when a complete run no longer reported the finding.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "severity": {
                  "description": "How hard a finding fails a run; serialized and parsed as the lowercase\nvariant name. Whether a finding also asks for review is not a level: it\nfollows from the severity its decision authored.",
                  "oneOf": [
                    {
                      "const": "error",
                      "description": "Fails the run.",
                      "type": "string"
                    },
                    {
                      "const": "warn",
                      "description": "Fails the run only under `--strict` or past `--max-warnings`.",
                      "type": "string"
                    },
                    {
                      "const": "info",
                      "description": "Reported, never fails the run.",
                      "type": "string"
                    }
                  ]
                },
                "standing": {
                  "anyOf": [
                    {
                      "description": "What the latest judgment does to a finding now.",
                      "oneOf": [
                        {
                          "const": "suppressed",
                          "description": "The finding stays out of reports.",
                          "type": "string"
                        },
                        {
                          "const": "judged",
                          "description": "The finding is judged and stays in the report (`fail` with no\nsuppression).",
                          "type": "string"
                        },
                        {
                          "const": "rule-changed",
                          "description": "The decision's meaning changed since the judgment: ask again.",
                          "type": "string"
                        },
                        {
                          "const": "evidence-changed",
                          "description": "The finding's evidence changed since the judgment: ask again.",
                          "type": "string"
                        },
                        {
                          "const": "unsuppressible",
                          "description": "Errors are definitive: no judgment hides them, whatever level they\nare configured at.",
                          "type": "string"
                        }
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "What that judgment does to the finding now."
                },
                "state": {
                  "description": "Where a finding is in its life; a judgment that hides it wins over the\nrest.",
                  "enum": [
                    "open",
                    "resolved",
                    "inactive",
                    "suppressed"
                  ],
                  "type": "string"
                },
                "symbol": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "fingerprint",
                "decision",
                "severity",
                "authoredSeverity",
                "path",
                "locator",
                "symbol",
                "message",
                "evidence",
                "facts",
                "options",
                "meaningVersion",
                "firstSeen",
                "lastSeen",
                "resolvedAt",
                "inactiveAt",
                "state",
                "reopened",
                "commit",
                "dirty",
                "lighthouseVersion",
                "catalogVersion",
                "judgment",
                "standing",
                "narrowing"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "tasks",
          "omitted"
        ],
        "type": "object"
      }
    ],
    "description": "The `ReviewList` kind: the findings that ask for review.",
    "title": "ReviewList",
    "type": "object"
  },
  "title": "List the findings that ask for review"
}
