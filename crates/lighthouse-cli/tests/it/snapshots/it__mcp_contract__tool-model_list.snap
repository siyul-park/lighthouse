---
source: crates/lighthouse-cli/tests/it/mcp_contract.rs
expression: "serde_json::to_string_pretty(&tool).unwrap()"
---
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "List the models bound to decisions.\n\nThe classification model, the models rules name and the trained models attached to decisions, with whether asking each reaches a service outside the machine.",
  "inputSchema": {
    "additionalProperties": false,
    "description": "`model list`.",
    "properties": {
      "decision": {
        "default": [],
        "description": "Only the models bound to these decisions: ids or globs.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "limit": {
        "default": null,
        "description": "List at most this many models and say how many were left out.",
        "format": "uint",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      }
    },
    "type": "object"
  },
  "name": "model_list",
  "outputSchema": {
    "$id": "https://raw.githubusercontent.com/siyul-park/lighthouse/main/schema/model-list.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "The `ModelList` kind.",
    "properties": {
      "models": {
        "items": {
          "description": "One model and what it is bound to.",
          "properties": {
            "binding": {
              "description": "Where a binding comes from.",
              "oneOf": [
                {
                  "const": "classification",
                  "description": "`models.classification`: the model for decisions nothing else binds.",
                  "type": "string"
                },
                {
                  "const": "agent",
                  "description": "`models.agent`: the agent that fixes by changing files.",
                  "type": "string"
                },
                {
                  "const": "rule-classification",
                  "description": "A rule of the configuration names it for classification.",
                  "type": "string"
                },
                {
                  "const": "rule-agent",
                  "description": "A rule of the configuration names it for the agent.",
                  "type": "string"
                },
                {
                  "const": "attached",
                  "description": "A trained model attached by an approved revision.",
                  "type": "string"
                }
              ]
            },
            "decision": {
              "description": "The decision it judges; none for the classification and agent\nmodels.",
              "type": [
                "string",
                "null"
              ]
            },
            "model": {
              "description": "`<provider>/<model>`.",
              "type": "string"
            },
            "remote": {
              "description": "Whether asking it reaches a service outside the machine.",
              "type": "boolean"
            }
          },
          "required": [
            "model",
            "decision",
            "binding",
            "remote"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "omitted": {
        "description": "How many models `limit` left out.",
        "format": "uint",
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "models",
      "omitted"
    ],
    "title": "ModelList",
    "type": "object"
  },
  "title": "List the models bound to decisions"
}
