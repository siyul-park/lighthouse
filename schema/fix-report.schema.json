{
  "$id": "https://raw.githubusercontent.com/siyul-park/lighthouse/main/schema/fix-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A finished fix run: the `FixReport` kind.",
  "properties": {
    "applied": {
      "items": {
        "description": "A fix that was applied.",
        "properties": {
          "decision": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "files": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "fingerprint": {
            "type": "string"
          },
          "fixer": {
            "type": "string"
          },
          "safety": {
            "type": "string"
          }
        },
        "required": [
          "fingerprint",
          "decision",
          "fixer",
          "safety",
          "description",
          "files"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "declined": {
      "items": {
        "description": "A finding that was left as it was, and why.",
        "properties": {
          "decision": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          },
          "line": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "fingerprint",
          "decision",
          "path",
          "line",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "diff": {
      "description": "The unified diff of every changed file, in path order.",
      "type": "string"
    },
    "dryRun": {
      "type": "boolean"
    },
    "messages": {
      "description": "What the user should know, in the order it happened.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "models": {
      "additionalProperties": {
        "description": "What became of the findings of one decision that were given to a model.",
        "properties": {
          "answered": {
            "description": "Of them, those it replied to.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "applied": {
            "description": "Verified fixes that were written.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "asked": {
            "description": "Findings the model was asked about.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "declined": {
            "additionalProperties": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "description": "Findings left as they were, by the class of the reason: `no-extent`,\n`unanswered`, `out-of-scope`, `conflict`, `unchanged`, `unresolved`,\n`introduced`, `incomplete` or `rolled-back`.",
            "type": "object"
          },
          "previewed": {
            "description": "Verified fixes left as previews.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "verified": {
            "description": "Replies the checks accepted.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "asked",
          "answered",
          "verified",
          "applied",
          "previewed",
          "declined"
        ],
        "type": "object"
      },
      "description": "What became of the findings given to a model, by decision. Absent when\nno model was asked.",
      "type": "object"
    },
    "previews": {
      "description": "`unsafe` fixes, by any provider, that the checks accepted and that were\nleft for a hand to apply (`[fix] unsafe = false` without\n`--unsafe-fixes`, or a failing `[fix] verify` command), each with its\ndiff and how to apply it. Absent when there are none.",
      "items": {
        "description": "An `unsafe` fix that was left for a hand to apply.",
        "properties": {
          "apply": {
            "description": "The command line.",
            "type": "string"
          },
          "decision": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "diff": {
            "description": "The unified diff of the fix.",
            "type": "string"
          },
          "files": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "fingerprint": {
            "type": "string"
          },
          "fixer": {
            "type": "string"
          },
          "safety": {
            "type": "string"
          },
          "tool": {
            "description": "A tool call: the twin of a command line.",
            "properties": {
              "arguments": true,
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "arguments"
            ],
            "type": "object"
          }
        },
        "required": [
          "fingerprint",
          "decision",
          "fixer",
          "safety",
          "description",
          "files",
          "diff",
          "apply",
          "tool"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "rounds": {
      "description": "How many times fixing was repeated until nothing was left.",
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "usage": {
      "description": "The requests that went to a model this run, and what they cost.\nAbsent when no model was asked.",
      "properties": {
        "calls": {
          "description": "Requests that went to a model (a run of an agent is one); answers kept\nfrom earlier runs are not counted.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "cost": {
          "format": "double",
          "type": "number"
        },
        "edit": {
          "description": "Present when the model is an agent that edits.",
          "properties": {
            "runs": {
              "description": "Runs of the agent; answers kept from earlier runs are not counted.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "seconds": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "runs",
            "seconds"
          ],
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "calls",
        "cost"
      ],
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "dryRun",
    "diff",
    "applied",
    "declined",
    "rounds",
    "messages"
  ],
  "title": "FixReport",
  "type": "object"
}
