{
  "$id": "https://raw.githubusercontent.com/siyul-park/lighthouse/main/schema/fix-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A finished fix run: the `FixReport` kind.",
  "properties": {
    "applied": {
      "items": {
        "description": "A fix that was applied.",
        "properties": {
          "decision": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "files": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "fingerprint": {
            "type": "string"
          },
          "fixer": {
            "type": "string"
          },
          "safety": {
            "type": "string"
          }
        },
        "required": [
          "fingerprint",
          "decision",
          "fixer",
          "safety",
          "description",
          "files"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "declined": {
      "items": {
        "description": "A finding that was left as it was, and why.",
        "properties": {
          "decision": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          },
          "line": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "fingerprint",
          "decision",
          "path",
          "line",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "diff": {
      "description": "The unified diff of every changed file, in path order.",
      "type": "string"
    },
    "dryRun": {
      "type": "boolean"
    },
    "messages": {
      "description": "What the user should know, in the order it happened.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "rounds": {
      "description": "How many times fixing was repeated until nothing was left.",
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "dryRun",
    "diff",
    "applied",
    "declined",
    "rounds",
    "messages"
  ],
  "title": "FixReport",
  "type": "object"
}
