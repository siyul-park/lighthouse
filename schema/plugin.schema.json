{
  "$defs": {
    "Metadata": {
      "additionalProperties": false,
      "description": "Who a resource is. Identity is `name`; grouping is by label, never by\nwhere the document is stored.",
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Free notes; never used to select.",
          "type": "object"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Selectable facts, keyed `lighthouse/<name>`.",
          "type": "object"
        },
        "name": {
          "description": "Fully qualified name, such as `design/no-redundant-qualifier`.",
          "type": "string"
        },
        "uid": {
          "description": "Identity that outlives the name: a UUID v4 assigned once, never derived\nfrom the name (Kubernetes `metadata.uid`). Renaming a resource keeps it.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "PluginSpec": {
      "additionalProperties": false,
      "description": "The spec of the `Plugin` kind: how to start a plugin process, and what the\nplugin provides.",
      "properties": {
        "catalog": {
          "description": "Directory of the plugin's decision catalog, relative to the manifest\ndirectory: the packs the plugin provides, read without starting the\nprocess.",
          "type": [
            "string",
            "null"
          ]
        },
        "provides": {
          "$ref": "#/$defs/Provides"
        },
        "runtime": {
          "anyOf": [
            {
              "$ref": "#/$defs/Runtime"
            },
            {
              "type": "null"
            }
          ],
          "description": "How to start the plugin's process; a bundled plugin, which the binary\ncompiles in, has none."
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "version"
      ],
      "type": "object"
    },
    "Provides": {
      "additionalProperties": false,
      "description": "What a plugin contributes, declared so that tools can list it without\nstarting the process. Each list is checked against what the process\nreports when it starts.",
      "properties": {
        "languages": {
          "description": "Language ids.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "models": {
          "description": "Model ids.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Runtime": {
      "additionalProperties": false,
      "description": "How a plugin process is started.",
      "properties": {
        "args": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command": {
          "description": "Executable. A relative path with a separator is resolved against the\nmanifest directory; a bare name is looked up on `PATH`.",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/siyul-park/lighthouse/main/schema/plugin.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "lighthouse/v1alpha1"
    },
    "kind": {
      "const": "Plugin"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "spec": {
      "$ref": "#/$defs/PluginSpec"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "Plugin",
  "type": "object"
}
