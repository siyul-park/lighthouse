{
  "$id": "https://raw.githubusercontent.com/siyul-park/lighthouse/main/schema/decision-list.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "decisions": {
      "items": {
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "severity",
          "title",
          "enabled"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "omitted": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "decisions",
    "omitted"
  ],
  "title": "DecisionList",
  "type": "object"
}
