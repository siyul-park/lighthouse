{
  "$id": "https://raw.githubusercontent.com/siyul-park/lighthouse/main/schema/signal-dismiss.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A recorded signal.",
  "oneOf": [
    {
      "properties": {
        "status": {
          "const": "open",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    {
      "description": "A decision was recorded from it: the uid of that decision.",
      "properties": {
        "decision": {
          "type": "string"
        },
        "status": {
          "const": "recorded",
          "type": "string"
        }
      },
      "required": [
        "status",
        "decision"
      ],
      "type": "object"
    },
    {
      "description": "An existing decision already says it: its uid.",
      "properties": {
        "decision": {
          "type": "string"
        },
        "status": {
          "const": "linked",
          "type": "string"
        }
      },
      "required": [
        "status",
        "decision"
      ],
      "type": "object"
    },
    {
      "properties": {
        "reason": {
          "type": "string"
        },
        "status": {
          "const": "dismissed",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "type": "object"
    }
  ],
  "properties": {
    "asked": {
      "description": "Whether a stop has asked the agent about it.",
      "type": "boolean"
    },
    "by": {
      "description": "Who it is attributed to: the person for what they said, the agent for\nwhat its edits caused, a model for what one classified.",
      "properties": {
        "hadRole": {
          "anyOf": [
            {
              "description": "The role a software agent had in a record, PROV's `hadRole`.",
              "oneOf": [
                {
                  "const": "agent",
                  "description": "A coding agent that reviewed the finding.",
                  "type": "string"
                },
                {
                  "const": "model",
                  "description": "A model that classified the subject.",
                  "type": "string"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "description": "What kind of agent a record is attributed to, a W3C PROV class.",
          "oneOf": [
            {
              "const": "Person",
              "description": "A human.",
              "type": "string"
            },
            {
              "const": "SoftwareAgent",
              "description": "A program, such as a coding agent or a model.",
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "class": {
      "description": "What a signal says.",
      "oneOf": [
        {
          "const": "directive",
          "description": "A rule to follow: \"always\", \"never\", \"must\", \"don't\".",
          "type": "string"
        },
        {
          "const": "correction",
          "description": "A turn away from what the agent did or chose: \"no, …\", \"instead\".",
          "type": "string"
        },
        {
          "const": "preference",
          "description": "A stated taste: \"X is better\", \"I prefer\".",
          "type": "string"
        },
        {
          "const": "finding",
          "description": "A finding the session introduced or resolved.",
          "type": "string"
        },
        {
          "const": "none",
          "description": "A message a rule proved says no decision (an acknowledgement).",
          "type": "string"
        },
        {
          "const": "abstain",
          "description": "A message no rule decides; a bound model could.",
          "type": "string"
        }
      ]
    },
    "event": {
      "description": "The hook event that saw it: `UserPromptSubmit`, `PostToolUse`, `Stop`.",
      "type": "string"
    },
    "excerpt": {
      "description": "Scrubbed and short: never the whole message.",
      "type": "string"
    },
    "features": {
      "description": "What was measured of it, never the text."
    },
    "id": {
      "type": "string"
    },
    "rule": {
      "description": "The classifier rule that fired, or the decision of a finding.",
      "type": "string"
    },
    "session": {
      "type": "string"
    },
    "settledBy": {
      "description": "Who settled it, as `--attributed-to` spells it.",
      "type": [
        "string",
        "null"
      ]
    },
    "time": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "session",
    "event",
    "class",
    "excerpt",
    "features",
    "rule",
    "by",
    "time",
    "asked"
  ],
  "title": "SignalDismiss",
  "type": "object"
}
