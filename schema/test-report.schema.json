{
  "$id": "https://raw.githubusercontent.com/siyul-park/lighthouse/main/schema/test-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "decisions": {
      "minimum": 0,
      "type": "integer"
    },
    "failures": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "languages": {
      "minimum": 0,
      "type": "integer"
    },
    "ok": {
      "type": "boolean"
    },
    "runs": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "ok",
    "decisions",
    "languages",
    "runs",
    "failures"
  ],
  "title": "TestReport",
  "type": "object"
}
