{
  "$id": "https://raw.githubusercontent.com/siyul-park/lighthouse/main/schema/decision-test.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The `DecisionTest` kind: the examples of the checked decisions, run.",
  "properties": {
    "conflicts": {
      "description": "One line per conflict with another decision that an example declares\nand still has: a candidate for a contradiction, not a failure.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "decisions": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "failures": {
      "description": "One line per failing example; empty when every example holds.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "languages": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "ok": {
      "description": "False when any example fails.",
      "type": "boolean"
    },
    "runs": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "skipped": {
      "description": "One line per example that was not run because the program its command\ncheck names is not installed; they are not failures.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "timings": {
      "description": "Where the time went; present only with `timings`.",
      "properties": {
        "check": {
          "description": "Building each example's engine and checking it.",
          "format": "double",
          "type": "number"
        },
        "crossing": {
          "description": "Checking the examples against the other decisions.",
          "format": "double",
          "type": "number"
        },
        "fix": {
          "description": "Applying the fixes and judging them.",
          "format": "double",
          "type": "number"
        },
        "pluginStart": {
          "description": "Starting the plugins.",
          "format": "double",
          "type": "number"
        },
        "slowest": {
          "description": "The decisions that took longest, with the language they ran in.",
          "items": {
            "description": "A decision and the time its examples took in one language.",
            "properties": {
              "decision": {
                "type": "string"
              },
              "language": {
                "type": "string"
              },
              "seconds": {
                "format": "double",
                "type": "number"
              }
            },
            "required": [
              "decision",
              "language",
              "seconds"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "pluginStart",
        "check",
        "fix",
        "crossing",
        "slowest"
      ],
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "ok",
    "decisions",
    "languages",
    "runs",
    "failures",
    "skipped",
    "conflicts"
  ],
  "title": "DecisionTest",
  "type": "object"
}
