{
  "$id": "https://raw.githubusercontent.com/siyul-park/lighthouse/main/schema/finding.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "authoredSeverity": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "evidence": {},
    "facts": {},
    "fingerprint": {
      "type": "string"
    },
    "firstSeen": {
      "type": "string"
    },
    "inactiveAt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "judgment": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "lastSeen": {
      "type": "string"
    },
    "locator": {
      "type": "object"
    },
    "message": {
      "type": "string"
    },
    "narrowing": {
      "type": "boolean"
    },
    "options": {},
    "path": {
      "type": "string"
    },
    "reopened": {
      "minimum": 0,
      "type": "integer"
    },
    "resolvedAt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "severity": {
      "type": "string"
    },
    "standing": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "symbol": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "fingerprint",
    "decision",
    "severity",
    "path",
    "message",
    "lastSeen"
  ],
  "title": "Finding",
  "type": "object"
}
