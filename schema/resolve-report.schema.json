{
  "$id": "https://raw.githubusercontent.com/siyul-park/lighthouse/main/schema/resolve-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "catalogError": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "recorded": {
      "properties": {
        "decision": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        },
        "judgment": {
          "type": "string"
        },
        "suppression": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "wasAttributedTo": {}
      },
      "required": [
        "fingerprint",
        "decision",
        "judgment"
      ],
      "type": "object"
    },
    "standing": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "recorded",
    "warnings"
  ],
  "title": "ResolveReport",
  "type": "object"
}
