{
  "$defs": {
    "Metadata": {
      "additionalProperties": false,
      "description": "Who a resource is. Identity is `name`; grouping is by label, never by\nwhere the document is stored.",
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Free notes; never used to select.",
          "type": "object"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Selectable facts, keyed `lighthouse/<name>`.",
          "type": "object"
        },
        "name": {
          "description": "Fully qualified name, such as `design/minimal-names`.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Reason": {
      "description": "Why a reviewer reached a verdict.",
      "oneOf": [
        {
          "const": "fixed",
          "description": "Confirmed and the code was changed.",
          "type": "string"
        },
        {
          "const": "accepted-debt",
          "description": "Confirmed and left as known debt.",
          "type": "string"
        },
        {
          "const": "false-positive",
          "description": "The rule misjudged this code.",
          "type": "string"
        },
        {
          "const": "intentional-exception",
          "description": "The code is right to break the rule here.",
          "type": "string"
        },
        {
          "const": "scope-too-broad",
          "description": "The rule matches more than it should; a hint to narrow the rule.",
          "type": "string"
        },
        {
          "const": "project-allowed",
          "description": "The project's conventions allow it.",
          "type": "string"
        },
        {
          "const": "not-worth-fixing",
          "description": "True but not worth the change.",
          "type": "string"
        },
        {
          "const": "none",
          "description": "No reason given: what a deferred verdict carries.",
          "type": "string"
        }
      ]
    },
    "ReviewerKind": {
      "description": "Who reviewed.",
      "enum": [
        "agent",
        "human"
      ],
      "type": "string"
    },
    "Verdict": {
      "description": "What a reviewer decided about a finding.",
      "oneOf": [
        {
          "const": "confirmed",
          "description": "The finding is right.",
          "type": "string"
        },
        {
          "const": "rejected",
          "description": "The finding is wrong or not wanted; it is suppressed from then on.",
          "type": "string"
        },
        {
          "const": "deferred",
          "description": "Not decided yet; the finding stays visible.",
          "type": "string"
        }
      ]
    },
    "VerdictSpec": {
      "description": "The spec of the `Verdict` record: a reviewer's judgment about one finding,\nwith the finding frozen as it was seen.",
      "properties": {
        "catalogVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "decisionHash": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidenceDigest": {
          "type": [
            "string",
            "null"
          ]
        },
        "fingerprint": {
          "type": "string"
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "lighthouseVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "patternFingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "$ref": "#/$defs/Reason"
        },
        "reasonText": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewerId": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewerKind": {
          "$ref": "#/$defs/ReviewerKind"
        },
        "ruleId": {
          "type": "string"
        },
        "ruleVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "snapshot": {
          "description": "The finding frozen at review time: evidence, facts, options, severity,\nauthored severity, when and where it was seen. Its severity is the string recorded\nthen, so history may say `review`."
        },
        "timestamp": {
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "fingerprint",
        "ruleId",
        "verdict",
        "reason",
        "reviewerKind",
        "snapshot",
        "timestamp"
      ],
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/siyul-park/lighthouse/main/schema/verdict.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "lighthouse/v1alpha1"
    },
    "kind": {
      "const": "Verdict"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "spec": {
      "$ref": "#/$defs/VerdictSpec"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "Verdict",
  "type": "object"
}
