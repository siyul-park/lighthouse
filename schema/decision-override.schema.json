{
  "$defs": {
    "DecisionOverrideSpec": {
      "additionalProperties": false,
      "description": "The spec of the `DecisionOverride` kind: a project's adjustment of a\ndecision of a lower layer. `severity` and `exceptions` replace, `options`\nreplace defaults per option, `languages` replace per language and key, and\n`examples` are appended.",
      "properties": {
        "examples": {
          "items": {
            "$ref": "#/$defs/Example"
          },
          "type": "array"
        },
        "exceptions": {
          "type": [
            "string",
            "null"
          ]
        },
        "extends": {
          "description": "Id of the decision adjusted.",
          "type": "string"
        },
        "languages": {
          "additionalProperties": {
            "$ref": "#/$defs/LanguageSpec"
          },
          "type": "object"
        },
        "options": {
          "additionalProperties": true,
          "description": "New defaults, by option name.",
          "type": "object"
        },
        "severity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Severity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "extends"
      ],
      "type": "object"
    },
    "Example": {
      "additionalProperties": false,
      "description": "A fixture project for one language and what a rule must report on it:\nnothing for `valid`, the diagnostics of `expect` for `invalid`.",
      "properties": {
        "canonical": {
          "description": "The example that best shows the decision in its language; at most one\nper language and kind. Agent output prefers it.",
          "type": "boolean"
        },
        "expect": {
          "description": "Diagnostics an invalid example must produce.",
          "items": {
            "$ref": "#/$defs/Expect"
          },
          "type": "array"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/ExampleFile"
          },
          "type": "array"
        },
        "fixed": {
          "description": "What an invalid example's files become when the decision's fix is\napplied: the files that change, each with its whole new text. Applying\nthe fix again must change nothing, and the rule must no longer fire.",
          "items": {
            "$ref": "#/$defs/ExampleFile"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/ExampleKind"
        },
        "language": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "options": {
          "additionalProperties": true,
          "description": "Rule options the example runs with.",
          "type": "object"
        }
      },
      "required": [
        "name",
        "language",
        "kind",
        "files"
      ],
      "type": "object"
    },
    "ExampleFile": {
      "additionalProperties": false,
      "description": "One file of an example project, addressed by `path` inside the example.\nIts text is a `body` written in the decision file, or a `source` file next\nto it.",
      "properties": {
        "body": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "ExampleKind": {
      "description": "Whether an example must produce no diagnostics (`valid`) or exactly those\nlisted in `expect` (`invalid`).",
      "enum": [
        "valid",
        "invalid"
      ],
      "type": "string"
    },
    "Expect": {
      "additionalProperties": false,
      "description": "An expected diagnostic of an invalid example.",
      "properties": {
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "line"
      ],
      "type": "object"
    },
    "LanguageSpec": {
      "additionalProperties": false,
      "description": "What one language changes about a decision.",
      "properties": {
        "options": {
          "additionalProperties": true,
          "description": "Values of the decision's options that replace their defaults here.",
          "type": "object"
        },
        "tuning": {
          "description": "Wording of the decision for this language.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Metadata": {
      "additionalProperties": false,
      "description": "Who a resource is. Identity is `name`; grouping is by label, never by\nwhere the document is stored.",
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Free notes; never used to select.",
          "type": "object"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Selectable facts, keyed `lighthouse/<name>`.",
          "type": "object"
        },
        "name": {
          "description": "Fully qualified name, such as `design/minimal-names`.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Severity": {
      "description": "How hard a finding fails a run; serialized and parsed as the lowercase\nvariant name. Whether a finding also asks for a verdict is not a level: it\nfollows from how its decision is enforced.",
      "oneOf": [
        {
          "const": "error",
          "description": "Fails the run.",
          "type": "string"
        },
        {
          "const": "warn",
          "description": "Fails the run only under `--strict` or past `--max-warnings`.",
          "type": "string"
        },
        {
          "const": "info",
          "description": "Reported, never fails the run.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://raw.githubusercontent.com/siyul-park/lighthouse/main/schema/decision-override.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "lighthouse/v1alpha1"
    },
    "kind": {
      "const": "DecisionOverride"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "spec": {
      "$ref": "#/$defs/DecisionOverrideSpec"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "DecisionOverride",
  "type": "object"
}
